# Copy this file to .env and fill it in.  NEVER commit .env to GitHub.

# Which model to use: ollama (free, local), openai, anthropic, or mock (offline test only)
LLM_PROVIDER=ollama
# Leave blank to use the default for the provider:
#   ollama -> llama3.1:8b    openai -> gpt-4o-mini    anthropic -> claude-haiku-5-5
LLM_MODEL=

# API keys (only the one for your provider is needed)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Ollama runs here by default
OLLAMA_BASE_URL=http://localhost:11434/v1

# Retrieval: chroma (vector database with embeddings) or tfidf (keyword baseline)
RETRIEVER=chroma
# Embeddings for chroma: default (free local MiniLM model), openai, or hash (offline test only)
EMBEDDING=default
TOP_K=4
